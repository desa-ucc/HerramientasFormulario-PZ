# ========================================================
# Configuración del Entorno - Portal Recepción
# ========================================================

# Configuración Base de Datos SQL Server
# El SA_PASSWORD debe cumplir con las políticas de complejidad de SQL Server
DB_SA_PASSWORD=YourStrong!Passw0rd
DB_PORT=1433

# Configuración Nginx (Frontend)
FRONTEND_PORT=8080

# URL del Webhook (para inyectar en build/runtime si fuera necesario,
# aunque en esta arquitectura standalone se compila en Angular)
WEBHOOK_URL=http://localhost:5678/webhook/archivos
